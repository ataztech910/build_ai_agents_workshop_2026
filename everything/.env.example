# ══════════════════════════════════════════════════════════════
#  Воркшоп: AI Agents — конфигурация провайдера
#  Выбери ОДИН вариант, раскомментируй нужные строки
# ══════════════════════════════════════════════════════════════

# ── Вариант A: Kitana Server (рекомендуется) ──────────────────
# Не нужен API ключ — работает через Claude CLI подписку
#
# 1. Запусти в отдельном терминале:
#    npx @kitana-sdk/server
#
# OPENAI_BASE_URL=http://localhost:4141/v1
# OPENAI_API_KEY=kitana
# MODEL=auto

# ── Вариант B: Gemini Flash (бесплатно) ───────────────────────
# Получи ключ: aistudio.google.com → Get API Key
#
# ⚠️  Лимит: 15 req/min на бесплатном тире
#     Если получаешь 429 — подожди 10 сек и повтори
# ⚠️  Google может использовать промпты для обучения моделей
#
# GOOGLE_GENAI_API_KEY=AIza...   # не GOOGLE_API_KEY — @google/adk эту переменную не читает
# MODEL=gemini-flash-latest

# ── Вариант C: Ollama (полностью локально) ────────────────────
# Установи: ollama.com → затем: ollama pull llama3.2
# Не нужен интернет и ключи — работает офлайн
#
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL=llama3.2

# ── Вариант D: Claude API (платный) ───────────────────────────
# Получи ключ: console.anthropic.com
#
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-4-5
