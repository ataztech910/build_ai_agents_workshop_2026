# ══════════════════════════════════════════════════════════════
#  Lead Finder — конфигурация
#  cp .env.example .env  → заполни нужный блок
# ══════════════════════════════════════════════════════════════

# Источник: telegram | youtube | reddit | instagram
SOURCE=telegram

# Тон офферов: дружелюбный | экспертный | прямой
OFFER_TONE=дружелюбный

# Лимиты
POSTS_LIMIT=10           # постов/тредов
COMMENTS_PER_POST=20     # комментариев с каждого поста
COMMENTS_LIMIT=100       # для YouTube и Instagram

# ──────────────────────────────────────────────────────────────
# TELEGRAM  (SOURCE=telegram)
# Credentials: https://my.telegram.org → API development tools
# ──────────────────────────────────────────────────────────────
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890
TG_CHANNEL=channel_name           # без @

# ──────────────────────────────────────────────────────────────
# YOUTUBE  (SOURCE=youtube)
# API Key: console.cloud.google.com → YouTube Data API v3
# Video ID: из URL youtube.com/watch?v=VIDEO_ID
# ──────────────────────────────────────────────────────────────
YT_API_KEY=AIzaSy...
YT_VIDEO_ID=dQw4w9WgXcQ

# ──────────────────────────────────────────────────────────────
# REDDIT  (SOURCE=reddit)
# App: reddit.com/prefs/apps → create app (тип: script)
# ──────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USERNAME=твой_логин
REDDIT_PASSWORD=твой_пароль
REDDIT_SUBREDDIT=entrepreneur     # без r/

# ──────────────────────────────────────────────────────────────
# INSTAGRAM  (SOURCE=instagram)
# Playwright логинится в твой аккаунт, сессия сохраняется в
# instagram_session.json (повторный вход не нужен)
#
# IG_HEADLESS=false  →  показывает браузер (удобно для отладки
#                        и первого логина с 2FA)
# ──────────────────────────────────────────────────────────────
IG_USERNAME=твой_логин
IG_PASSWORD=твой_пароль
IG_POST_URL=https://www.instagram.com/p/SHORT_CODE/
IG_HEADLESS=true
