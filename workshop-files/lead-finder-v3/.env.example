# ══════════════════════════════════════════════════════════════
#  Lead Finder — config
#  cp .env.example .env  → fill in the block you need
# ══════════════════════════════════════════════════════════════

# Source: telegram | youtube | reddit | instagram
SOURCE=telegram

# Offer tone: friendly | expert | direct
OFFER_TONE=friendly

# Limits
POSTS_LIMIT=10           # posts/threads
COMMENTS_PER_POST=20     # comments per post
COMMENTS_LIMIT=100       # for YouTube and Instagram

# ──────────────────────────────────────────────────────────────
# TELEGRAM  (SOURCE=telegram)
# Credentials: https://my.telegram.org → API development tools
# ──────────────────────────────────────────────────────────────
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890
TG_CHANNEL=channel_name           # without @

# ──────────────────────────────────────────────────────────────
# YOUTUBE  (SOURCE=youtube)
# API Key: console.cloud.google.com → YouTube Data API v3
# Video ID: from the URL youtube.com/watch?v=VIDEO_ID
# ──────────────────────────────────────────────────────────────
YT_API_KEY=AIzaSy...
YT_VIDEO_ID=dQw4w9WgXcQ

# ──────────────────────────────────────────────────────────────
# REDDIT  (SOURCE=reddit)
# App: reddit.com/prefs/apps → create app (type: script)
# ──────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USERNAME=your_login
REDDIT_PASSWORD=your_password
REDDIT_SUBREDDIT=entrepreneur     # without r/

# ──────────────────────────────────────────────────────────────
# INSTAGRAM  (SOURCE=instagram) — not recommended, see README
# Playwright logs into your account, session is saved to
# instagram_session.json (no need to log in again)
#
# IG_HEADLESS=false  →  shows the browser (handy for debugging
#                        and the first login with 2FA)
# ──────────────────────────────────────────────────────────────
IG_USERNAME=your_login
IG_PASSWORD=your_password
IG_POST_URL=https://www.instagram.com/p/SHORT_CODE/
IG_HEADLESS=true
