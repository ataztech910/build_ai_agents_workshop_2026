  "active": false,
  "settings": {},
  "nodes": [
    {
      "parameters": {},
      "id": "1a1b1c1d-0001-4001-8001-000000000001",
      "name": "New Business Description",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1120, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-businessDescription",
              "name": "businessDescription",
              "type": "string",
              "value": "A course on automating business operations with AI, for small business owners drowning in manual admin work."
            }
          ]
        },
        "options": {}
      },
      "id": "1a1b1c1d-0002-4001-8001-000000000002",
      "name": "Set Business Description",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-900, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8001/apps/planner/users/u1/sessions/s1",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "id": "1a1b1c1d-0003-4001-8001-000000000003",
      "name": "Create Planner Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-680, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8001/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appName: \"planner\", userId: \"u1\", sessionId: \"s1\", newMessage: { role: \"user\", parts: [{ text: $('Set Business Description').item.json.businessDescription }] } }) }}",
        "options": {}
      },
      "id": "1a1b1c1d-0004-4001-8001-000000000004",
      "name": "Call Planner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-460, 0]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst events = (items.length === 1 && Array.isArray(items[0].json)) ? items[0].json : items.map(i => i.json);\nconst lastEvent = events[events.length - 1];\nconst raw = lastEvent.content.parts[0].text;\nconst clean = raw.replace(/```json\\n?|```/g, '').trim();\nconst parsed = JSON.parse(clean);\nreturn [{ json: { channel: parsed.channel, reason: parsed.reason } }];"
      },
      "id": "1a1b1c1d-0005-4001-8001-000000000005",
      "name": "Extract Channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://workshop-data-portal.vercel.app/api/comments",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "channel",
              "value": "={{ $json.channel }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1a1b1c1d-0006-4001-8001-000000000006",
      "name": "Fetch Portal Comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 0]
    },
    {
      "parameters": {
        "jsCode": "const businessDescription = $('Set Business Description').item.json.businessDescription;\nconst comments = $json.comments;\nconst prompt = `ICP: ${businessDescription}\\nComments: ${JSON.stringify(comments, null, 2)}`;\nreturn [{ json: { prompt } }];"
      },
      "id": "1a1b1c1d-0007-4001-8001-000000000007",
      "name": "Build Lead-Finder Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/apps/lead-finder/users/u1/sessions/s2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "id": "1a1b1c1d-0008-4001-8001-000000000008",
      "name": "Create Lead-Finder Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appName: \"lead-finder\", userId: \"u1\", sessionId: \"s2\", newMessage: { role: \"user\", parts: [{ text: $('Build Lead-Finder Prompt').item.json.prompt }] } }) }}",
        "options": {}
      },
      "id": "1a1b1c1d-0009-4001-8001-000000000009",
      "name": "Call Lead-Finder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 0]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst events = (items.length === 1 && Array.isArray(items[0].json)) ? items[0].json : items.map(i => i.json);\nconst lastEvent = events[events.length - 1];\nconst raw = lastEvent.content.parts[0].text;\nconst clean = raw.replace(/```json\\n?|```/g, '').trim();\nconst parsed = JSON.parse(clean);\nreturn parsed.offers.map(o => ({ json: o }));"
      },
      "id": "1a1b1c1d-0010-4001-8001-000000000010",
      "name": "Parse Final Offers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 0]
    },
    {
      "parameters": {
        "type": "simple",
        "sortFieldsUi": {
          "sortField": [
            {
              "fieldName": "author",
              "order": "ascending"
            }
          ]
        }
      },
      "id": "1a1b1c1d-0011-4001-8001-000000000011",
      "name": "Sort By Author",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [1080, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-summary",
              "name": "summary",
              "type": "string",
              "value": "={{ $json.author + ' — ' + $json.hook + ' — ' + $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1a1b1c1d-0012-4001-8001-000000000012",
      "name": "Format Result",
