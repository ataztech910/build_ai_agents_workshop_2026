# ── Модель ────────────────────────────────────────────────
# MODEL=gemini-flash-latest   — Gemini напрямую, нужен GOOGLE_GENAI_API_KEY ниже
# MODEL=kitana                — через Claude CLI подписку или Ollama, без ключей
#                                (не нужен отдельный сервер — @kitana-sdk/adk
#                                подключается прямо в коде агента)
MODEL=gemini-flash-latest

# ── Волна 2: API ключи (нужен хотя бы один, смотря какой MODEL выбран) ──
# ANTHROPIC_API_KEY=sk-ant-...        # claude API
# GOOGLE_GENAI_API_KEY=AIza...         # gemini (бесплатный: aistudio.google.com) — @google/adk читает именно эту переменную, не GOOGLE_API_KEY

# ── Волна 3: Kitana (MODEL=kitana) ───────────────────────────
# Нужен либо `claude login` (подписка Claude), либо запущенный Ollama
# (ollama pull llama3.2 и т.п.) — @kitana-sdk/adk сам пробует claude,
# при неудаче падает на ollama.
# Если через Ollama падает с "404 Not Found" — значит у тебя не установлена
# модель llama3 (дефолт по умолчанию). Укажи здесь имя своей модели
# (проверить: `ollama list`):
# OLLAMA_MODEL=llama3.2
