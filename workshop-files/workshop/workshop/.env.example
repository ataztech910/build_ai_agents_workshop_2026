# cp .env.example .env, then fill in the key below.
#
# Model choice isn't set here — every agent file has its own pickModel()
# with a "comment one line, uncomment the other" toggle right in the code
# (Gemini by default, Kitana as the commented-out alternative). This file
# only needs the credentials those choices actually require.

# ── Gemini (default provider) ──────────────────────────────
# Free tier: aistudio.google.com → "Get API key". Don't enable Cloud
# billing on the project — it permanently drops you out of the free tier.
# @google/adk reads exactly this variable name, not GOOGLE_API_KEY.
GOOGLE_GENAI_API_KEY=AIzaSy...

# ── Kitana (optional — uncomment the KitanaLlm line in any pickModel()) ──
# No API key needed here. Uses your Claude CLI subscription
# (`npm install -g @anthropic-ai/claude-code`, then run `claude` once to
# log in — needs a Pro/Max/Team/Enterprise plan, Free has no CLI access)
# or a local Ollama model as fallback.
#
# If the Ollama fallback fails with "404 Not Found", you don't have the
# default model (llama3.2) pulled — either `ollama pull llama3.2`, or
# point this at whatever you do have (check with `ollama list`):
# OLLAMA_MODEL=llama3.2

# ── Optional: Claude via a real API key (Python hello_agent.py's LiteLlm
# path only — not used by any TypeScript file's default) ────────────────
# ANTHROPIC_API_KEY=sk-ant-...
