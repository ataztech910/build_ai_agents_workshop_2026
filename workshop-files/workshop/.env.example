# ── Волна 2: API ключи (нужен хотя бы один) ──────────────
ANTHROPIC_API_KEY=sk-ant-...        # claude API
GOOGLE_GENAI_API_KEY=AIza...         # gemini (бесплатный: aistudio.google.com) — @google/adk читает именно эту переменную, не GOOGLE_API_KEY

# ── Волна 3: Kitana ───────────────────────────────────────
KITANA_PROVIDERS=claude,ollama      # порядок = приоритет failover
KITANA_MODEL=llama3.2               # модель для ollama
KITANA_OLLAMA_URL=http://localhost:11434
